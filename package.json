{
  "name": "verde-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev --port 4387",
    "build": "astro build",
    "preview": "astro preview --port 4388",
    "astro": "astro",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.2",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^6.0.3"
  }
}
