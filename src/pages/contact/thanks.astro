---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you" description="Thank you for contacting Magazine Verde. Keep exploring ideas for greener city living.">
  <section class="panel hero" aria-labelledby="thanks-title">
    <p class="eyebrow">Keep the conversation growing</p>
    <h1 id="thanks-title">Thank you for <span>saying hello.</span></h1>
    <p>If you've just completed the form, your enquiry has been submitted through FormSubmit. We'll reply to the email address you provided once it reaches our inbox.</p>
    <p>If you have any trouble sending your message, you can always email <a href="mailto:stuart@1976.london">stuart@1976.london</a> directly.</p>
    <div class="actions">
      <a class="button" href="/projects/">Explore our projects <span aria-hidden="true">&nearr;</span></a>
      <a class="button secondary" href="/contact/">Back to Contact</a>
    </div>
  </section>
</BaseLayout>
